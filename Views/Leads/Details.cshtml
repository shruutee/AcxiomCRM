@model Lead
@{ ViewData["Title"] = "Lead Details"; }
<div class="page-heading"><h1 class="h3">@Model.LeadName</h1><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel"><dl class="row">
<dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.LeadCode</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
<dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd>
<dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
<dt class="col-sm-3">Expected Value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C0")</dd>
<dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd>
</dl></div>
