@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Leads";
}
<div class="page-heading"><h1 class="h3">Leads</h1><a class="btn btn-primary" asp-action="Create">Create Lead</a></div>
<div class="panel">
    <form class="row g-2 mb-3" method="get">
        <div class="col-md-4"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search lead, company, email" /></div>
        <div class="col-md-3"><select class="form-select" name="status" asp-items="@(new SelectList(CrmLookups.LeadStatuses, ViewBag.Status))"><option value="">All statuses</option></select></div>
        <div class="col-md-3"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div>
        <div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
    </form>
    <table class="table table-hover align-middle"><thead><tr><th>Code</th><th>Name</th><th>Company</th><th>Source</th><th>Priority</th><th>Status</th><th>Expected</th><th></th></tr></thead><tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.LeadCode</td><td>@item.LeadName</td><td>@item.CompanyName</td><td>@item.Source</td><td>@item.Priority</td><td><span class="badge badge-soft">@item.Status</span></td><td>@item.ExpectedValue.ToString("C0")</td>
        <td class="table-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.LeadId">Details</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.LeadId">Edit</a>
        <form class="d-inline" method="post" asp-action="Convert" asp-route-id="@item.LeadId"><button class="btn btn-sm btn-outline-success">Convert</button></form>
        <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@item.LeadId"><button class="btn btn-sm btn-outline-danger">Lost</button></form></td></tr>
    }
    </tbody></table>
</div>
