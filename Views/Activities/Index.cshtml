@model IEnumerable<Activity>
@{ ViewData["Title"] = "Activities"; }
<div class="page-heading"><h1 class="h3">Activities</h1><a class="btn btn-primary" asp-action="Create">Create Activity</a></div>
<div class="panel"><form class="row g-2 mb-3" method="get"><div class="col-md-2"><select class="form-select" name="type" asp-items="@(new SelectList(CrmLookups.ActivityTypes, ViewBag.Type))"><option value="">All types</option></select></div><div class="col-md-2"><select class="form-select" name="status" asp-items="@(new SelectList(CrmLookups.ActivityStatuses, ViewBag.Status))"><option value="">All statuses</option></select></div><div class="col-md-2"><input type="date" class="form-control" name="date" value="@ViewBag.Date" /></div><div class="col-md-3"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<table class="table table-hover"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Status</th><th>Description</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ActivityDate.ToString("yyyy-MM-dd")</td><td>@item.ActivityType</td><td>@item.Subject</td><td>@item.Status</td><td>@item.Description</td></tr> }</tbody></table></div>
