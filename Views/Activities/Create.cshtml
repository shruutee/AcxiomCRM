@model Activity
@{ ViewData["Title"] = "Create Activity"; }
<div class="page-heading"><h1 class="h3">Create Activity</h1><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid">
<div><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select" asp-items="@(new SelectList(CrmLookups.ActivityTypes))"></select><span asp-validation-for="ActivityType"></span></div>
<div><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" type="date" class="form-control" /><span asp-validation-for="ActivityDate"></span></div>
<div><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="@(new SelectList(CrmLookups.ActivityStatuses))"></select><span asp-validation-for="Status"></span></div>
<div><label asp-for="AssignedTo" class="form-label"></label><select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Owners"></select><span asp-validation-for="AssignedTo"></span></div>
<div><label asp-for="CustomerId" class="form-label"></label><select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"><option value="">No customer</option></select></div>
<div><label asp-for="LeadId" class="form-label"></label><select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads"><option value="">No lead</option></select></div>
</div><div class="mt-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject"></span></div><div class="mt-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea><span asp-validation-for="Description"></span></div><button class="btn btn-primary mt-3">Save</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
