@model IEnumerable<AuditLog>
@{ ViewData["Title"] = "Audit Log"; }
<div class="page-heading"><h1 class="h3">Audit Log</h1></div>
<div class="panel"><form class="row g-2 mb-3" method="get"><div class="col-md-3"><input class="form-control" name="userName" value="@ViewBag.UserName" placeholder="User" /></div><div class="col-md-3"><input class="form-control" name="entityName" value="@ViewBag.EntityName" placeholder="Entity" /></div><div class="col-md-3"><input class="form-control" name="action" value="@ViewBag.Action" placeholder="Action" /></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<table class="table table-hover table-sm"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>Record</th><th>Result</th><th>Details</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.CreatedDate.ToLocalTime()</td><td>@item.UserName</td><td>@item.Action</td><td>@item.EntityName</td><td>@item.RecordId</td><td>@item.Result</td><td>@item.NewValue</td></tr> }</tbody></table></div>
