@model IEnumerable<FollowUp>
@{ ViewData["Title"] = "Follow-Ups"; }
<div class="page-heading"><h1 class="h3">Follow-Ups</h1><a class="btn btn-primary" asp-action="Create">Schedule Follow-Up</a></div>
<div class="panel"><form class="row g-2 mb-3" method="get"><div class="col-md-2"><input type="date" class="form-control" name="date" value="@ViewBag.Date" /></div><div class="col-md-2"><select class="form-select" name="status" asp-items="@(new SelectList(CrmLookups.FollowUpStatuses, ViewBag.Status))"><option value="">All statuses</option></select></div><div class="col-md-2"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div><div class="col-md-2"><select class="form-select" name="customerId" asp-items="ViewBag.Customers"><option value="">All customers</option></select></div><div class="col-md-2"><select class="form-select" name="leadId" asp-items="ViewBag.Leads"><option value="">All leads</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<table class="table table-hover"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.FollowUpDate.ToString("yyyy-MM-dd")</td><td>@item.FollowUpType</td><td>@item.Subject</td><td>@(item.CustomerId.HasValue ? $"Customer #{item.CustomerId}" : item.LeadId.HasValue ? $"Lead #{item.LeadId}" : item.OpportunityId.HasValue ? $"Opportunity #{item.OpportunityId}" : "")</td><td>@item.Status</td><td class="table-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.FollowUpId">Edit</a> <form class="d-inline" method="post" asp-action="Complete" asp-route-id="@item.FollowUpId"><button class="btn btn-sm btn-outline-success">Complete</button></form></td></tr> }</tbody></table></div>
