@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Opportunities"; }
<div class="page-heading"><h1 class="h3">Opportunities</h1><a class="btn btn-primary" asp-action="Create">Create Opportunity</a></div>
<div class="panel">
<form class="row g-2 mb-3" method="get"><div class="col-md-3"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search opportunity" /></div><div class="col-md-2"><select class="form-select" name="stage" asp-items="@(new SelectList(CrmLookups.OpportunityStages, ViewBag.Stage))"><option value="">All stages</option></select></div><div class="col-md-2"><select class="form-select" name="status" asp-items="@(new SelectList(CrmLookups.OpportunityStatuses, ViewBag.Status))"><option value="">All statuses</option></select></div><div class="col-md-2"><select class="form-select" name="customerId" asp-items="ViewBag.Customers"><option value="">All customers</option></select></div><div class="col-md-2"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div><div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div></form>
<table class="table table-hover align-middle"><thead><tr><th>Name</th><th>Source</th><th>Stage</th><th>Status</th><th>Amount</th><th>Probability</th><th>Weighted</th><th>Close Date</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.OpportunityName</td><td>@item.Source</td><td>@item.Stage</td><td>@item.Status</td><td>@item.Amount.ToString("C0")</td><td>@item.Probability%</td><td>@item.WeightedPipeline.ToString("C0")</td><td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td><td class="table-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.OpportunityId">Details</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OpportunityId">Edit</a> <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@item.OpportunityId"><button class="btn btn-sm btn-outline-danger">Lost</button></form></td></tr> }
</tbody></table></div>
