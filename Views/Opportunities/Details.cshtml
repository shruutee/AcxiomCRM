@model Opportunity
@{ ViewData["Title"] = "Opportunity Details"; }
<div class="page-heading"><h1 class="h3">@Model.OpportunityName</h1><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel"><dl class="row"><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd><dt class="col-sm-3">Stage</dt><dd class="col-sm-9">@Model.Stage</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("C0")</dd><dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability%</dd><dt class="col-sm-3">Weighted Pipeline</dt><dd class="col-sm-9">@Model.WeightedPipeline.ToString("C0")</dd><dt class="col-sm-3">Expected Close</dt><dd class="col-sm-9">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></div>
