@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Reports"; }
<div class="page-heading"><h1 class="h3">Reports</h1></div>
<div class="panel mb-3">
<form class="row g-2" method="get">
<div class="col-md-2"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div>
<div class="col-md-2"><select class="form-select" name="stage" asp-items="@(new SelectList(CrmLookups.OpportunityStages, ViewBag.Stage))"><option value="">All stages</option></select></div>
<div class="col-md-2"><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div>
<div class="col-md-2"><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div>
<div class="col-auto"><button class="btn btn-outline-primary">Filter</button></div>
<div class="col-auto"><button class="btn btn-outline-secondary" name="export" value="csv">Export CSV</button></div>
</form>
</div>
<div class="row g-3">
<div class="col-lg-3"><div class="panel"><h2 class="h5">Customer Report</h2>@foreach (var row in (Dictionary<string,int>)ViewBag.Customers) { <div class="d-flex justify-content-between"><span>@row.Key</span><strong>@row.Value</strong></div> }</div></div>
<div class="col-lg-3"><div class="panel"><h2 class="h5">Lead Report</h2>@foreach (var row in (Dictionary<string,int>)ViewBag.Leads) { <div class="d-flex justify-content-between"><span>@row.Key</span><strong>@row.Value</strong></div> }</div></div>
<div class="col-lg-3"><div class="panel"><h2 class="h5">Follow-Up Report</h2>@foreach (var row in (Dictionary<string,int>)ViewBag.FollowUps) { <div class="d-flex justify-content-between"><span>@row.Key</span><strong>@row.Value</strong></div> }</div></div>
<div class="col-lg-3"><div class="panel"><h2 class="h5">Conversion</h2><div>Converted: @ViewBag.Conversion.Converted</div><div>Lost: @ViewBag.Conversion.Lost</div><div>Open: @ViewBag.Conversion.Open</div></div></div>
</div>
<div class="panel mt-3"><h2 class="h5">User Activity Report</h2>@foreach (var row in (Dictionary<string,int>)ViewBag.UserActivity) { <div class="d-flex justify-content-between"><span>@row.Key</span><strong>@row.Value</strong></div> }</div>
<div class="panel mt-3"><h2 class="h5">Pipeline Report</h2><table class="table"><thead><tr><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Weighted Pipeline</th><th>Expected Close</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.OpportunityName</td><td>@item.Stage</td><td>@item.Amount.ToString("C0")</td><td>@item.Probability%</td><td>@item.WeightedPipeline.ToString("C0")</td><td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td></tr> }</tbody></table></div>
