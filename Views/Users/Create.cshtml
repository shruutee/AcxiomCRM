@model CreateUserViewModel
@{ ViewData["Title"] = "Create User"; }
<div class="page-heading"><h1 class="h3">Create User</h1><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
<div class="panel"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid">
<div><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName"></span></div>
<div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
<div><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password"></span></div>
<div><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select" asp-items="@(new SelectList(CrmRoles.All))"></select><span asp-validation-for="Role"></span></div>
<div class="form-check mt-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
</div><button class="btn btn-primary mt-3">Save</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
