@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}
<div class="page-heading">
    <h1 class="h3">Customers</h1>
    <a class="btn btn-primary" asp-action="Create">Create Customer</a>
</div>
<div class="panel">
    <form class="row g-2 mb-3" method="get">
        <div class="col-md-4"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search name, email, phone, company" /></div>
        <div class="col-md-2"><select class="form-select" name="status" asp-items="@(new SelectList(CrmLookups.CustomerStatuses, ViewBag.Status))"><option value="">All statuses</option></select></div>
        <div class="col-md-3"><select class="form-select" name="ownerId" asp-items="ViewBag.OwnerOptions"><option value="">All owners</option></select></div>
        <div class="col-auto"><button class="btn btn-outline-primary">Search</button></div>
    </form>
    <table class="table table-hover align-middle">
        <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerCode</td><td>@item.CustomerName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.CompanyName</td><td><span class="badge badge-soft">@item.Status</span></td>
                <td class="table-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.CustomerId">Details</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a>
                    <form class="d-inline" method="post" asp-action="Delete" asp-route-id="@item.CustomerId" onsubmit="return confirm('Deactivate this customer?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td>
            </tr>
        }
        </tbody>
    </table>
</div>
